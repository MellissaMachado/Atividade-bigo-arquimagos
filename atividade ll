    print("\n--- O(n log n) ---")
    monstros = [("Dragão", 95), ("Goblin", 10), ("Troll", 60), ("Slime", 3), ("Hidra", 80)]
    print(ordenar_monstros(monstros))

    print("\n--- O(n²) ---")
    print(duelo_dos_aprendizes([42, 7, 19, 3, 88, 25]))  # [3, 7, 19, 25, 42, 88]

    print("\n--- O(2^n) ---")
    pocoes = conjunto_das_pocoes(["fogo", "gelo", "raio"])
    print(len(pocoes))  # 8 (= 2^3)
    print(pocoes)

    print("\n--- O(n!) ---")
    rotas = rotas_do_mensageiro(["Norte", "Sul", "Leste"])
    print(len(rotas))  # 6 (= 3!)
    for rota in rotas:
        print(rota)
